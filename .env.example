# ===================================
# Nexus Ecosystem - Environment Variables
# ===================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# === Nexus AI Gateway ===
GROQ_KEY_1=gsk_your_groq_key_here
GEMINI_KEY_1=AIzaSy_your_gemini_key_here
OPENROUTER_KEY_1=sk-or-v1-your_openrouter_key_here
CEREBRAS_KEY_1=your_cerebras_key_here

# === Open WebUI ===
NEXUS_API_KEY=your_nexus_gateway_key
WEBUI_SECRET_KEY=your_64_char_secret_key_here

# === n8n ===
N8N_ENCRYPTION_KEY=your_32_char_encryption_key

# === Optional: RAG Embeddings ===
# Only needed if using OpenAI embeddings instead of local
# OPENAI_EMBEDDINGS_KEY=sk-proj-your_key_here

# === Optional: Webhooks ===
# N8N_WEBHOOK_TOKEN=your_webhook_token_here
